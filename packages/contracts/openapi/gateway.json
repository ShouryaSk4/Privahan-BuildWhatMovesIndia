{"openapi": "3.1.0", "info": {"title": "Parivahan MVP \u2014 Integration Gateway (Module 5)", "description": "Stable internal interface to government systems. Mock-backed until real access exists.", "version": "0.1.0"}, "paths": {"/healthz": {"get": {"summary": "Healthz", "operationId": "healthz_healthz_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Healthz Healthz Get"}}}}}}}, "/gov/ll-applications": {"post": {"summary": "Submit Ll Application", "operationId": "submit_ll_application_gov_ll_applications_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/LLApplicationSubmission"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GovSubmissionResult"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/gov/applications/{application_number}": {"get": {"summary": "Get Application Status", "operationId": "get_application_status_gov_applications__application_number__get", "parameters": [{"name": "application_number", "in": "path", "required": true, "schema": {"type": "string", "title": "Application Number"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GovApplicationStatus"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/gov/applications/{application_number}/verify-documents": {"post": {"summary": "Verify Documents", "description": "Mock RTO-side document verification.\n\nWith real Sarathi access this becomes an inbound status we poll or receive;\nthe mock exposes it as an action so the journey can be exercised end to end.", "operationId": "verify_documents_gov_applications__application_number__verify_documents_post", "parameters": [{"name": "application_number", "in": "path", "required": true, "schema": {"type": "string", "title": "Application Number"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GovApplicationStatus"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/gov/dl-test/slots": {"get": {"summary": "List Dl Test Slots", "operationId": "list_dl_test_slots_gov_dl_test_slots_get", "parameters": [{"name": "rto_code", "in": "query", "required": true, "schema": {"type": "string", "title": "Rto Code"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/TestSlot"}, "title": "Response List Dl Test Slots Gov Dl Test Slots Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/gov/dl-test/bookings": {"post": {"summary": "Book Dl Test", "operationId": "book_dl_test_gov_dl_test_bookings_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SlotBookingRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SlotBookingResult"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/gov/test-results": {"post": {"summary": "Report Test Result", "description": "Record an LL or DL test outcome (mock stand-in for the RTO reporting it).", "operationId": "report_test_result_gov_test_results_post", "requestBody": {"cont