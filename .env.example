# Environment Configuration for Parivahan MVP

# =========================================================
# Google Gemini 3.5 Suite Configuration
# =========================================================
GEMINI_API_KEY=
# Module 4 & 6 Text / Classification Model: Gemini 3.5 Flash Lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Module 6 Voice Synthesis: Gemini 3.5 Flash TTS
GEMINI_TTS_MODEL=gemini-3.5-flash-tts
# Module 6 Speech-to-Text: Gemini 3.5 Transcribe
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# =========================================================
# Module 3 - Identity Service (Port 8003)
# =========================================================
IDENTITY_SERVICE_PORT=8003
IDENTITY_SERVICE_HOST=127.0.0.1
# MOCK_DIGILOCKER=true allows local development without UIDAI/AUA empanelment
MOCK_DIGILOCKER=true

# =========================================================
# Module 4 - Driving Academy Assistant (Port 8004)
# =========================================================
ACADEMY_SERVICE_PORT=8004
ACADEMY_SERVICE_HOST=127.0.0.1
# LLM Provider for Academy: "gemini" or "mock"
ACADEMY_LLM_PROVIDER=gemini

# =========================================================
# Module 6 - Bol Ke Apply MCP Server & Console (Port 8006)
# =========================================================
BOL_KE_APPLY_PORT=8006
BOL_KE_APPLY_HOST=127.0.0.1
# LLM Provider for Bol Ke Apply: "gemini" or "mock"
BOL_KE_APPLY_LLM_PROVIDER=gemini
